<?php

/**
 * @file islandora_advanced_oai.module
 * Provides an advanced OAI-PMH data provider for Islandora 7.
 *
 * Features:
 * - Direct Solr querying for performance (bypasses Drupal's internal Solr module).
 * - Hybrid data fetching: Solr for metadata (speed), Fedora for rights (precision).
 * - Full OAI-PMH paging with HMAC-signed resumptionTokens for security.
 * - OpenAIRE v4.0 compliance (funding, DOIs, resource types).
 * - Unpaywall optimization (direct PDF links, versioning, embargo handling).
 * - Security hardening (XXE protection, admin impersonation, no-cache on error).
 */

// --- CONFIGURATION ---
// Define the internal URL to your Solr core here.
// This allows the module to send raw queries bypassing Drupal's access filters.
// Default: 'http://localhost:8080/solr'
define('oai2a_SOLR_URL', 'http://localhost:8080/solr');
define('oai2a_SOLR_CORE', 'collection1');

/**
 * Implements hook_menu().
 * Registers the OAI endpoint URLs for each institute.
 */
function oai2a_menu() {
  $items = array();
  // Register path /oai2a — works for all institutes.
  // In a multi-site/subdirectory Drupal install (e.g., /eawag/, /empa/, ...),
  // each institute has its own Drupal base URL, so the internal path is always 'oai2a'.
  // The institute is detected from the URL in oai2a_request_handler().
  $items['oai2a'] = array(
    'title' => 'Advanced OAI-PMH Provider',
    'page callback' => 'oai2a_request_handler',
    'access arguments' => array('access content'),
    'type' => MENU_CALLBACK,
  );

  return $items;
}

/**
 * Main Request Handler.
 * Dispatches OAI verbs, handles caching, and manages security.
 */
function oai2a_request_handler($institute = 'all') {
  drupal_add_http_header('Content-Type', 'text/xml; charset=utf-8');

  // --- ERROR SUPPRESSION ---
  // Prevent harmless Warnings and Notices from third-party modules (like Views)
  // from breaking the XML response or triggering 500 Internal Server Exceptions.
  error_reporting(E_ERROR | E_PARSE | E_CORE_ERROR | E_COMPILE_ERROR | E_USER_ERROR);
  ini_set('display_errors', 0);

  // --- INSTITUTE CONTEXT ---
  // Detect institute from the raw server URL and Drupal's base_path().
  // In a multi-site/subdirectory Drupal install (e.g., /eawag/ is the base path),
  // arg(0) only returns the internal Drupal path ('oai2a'), not the institute.
  // So we extract the institute from the base_path or REQUEST_URI instead.
  $valid_institutes = array('eawag', 'empa', 'wsl', 'psi');

  // Strategy 1: Check Drupal's base_path (e.g., '/eawag/' → 'eawag')
  $base = trim(base_path(), '/');
  if (in_array($base, $valid_institutes)) {
    $institute = $base;
  }

  // Strategy 2: Fallback to parsing the raw REQUEST_URI
  if ($institute === 'all') {
    $uri_path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    $uri_parts = explode('/', trim($uri_path, '/'));
    foreach ($uri_parts as $part) {
      if (in_array($part, $valid_institutes)) {
        $institute = $part;
        break;
      }
    }
  }
  // Store in drupal_static for helpers (Solr query builders etc.) to access.
  $inst_static = &drupal_static('_oai2a_current_institute', 'all');
  $inst_static = $institute;

  // Security: Disable external entity loading to prevent XXE attacks
  // Note: libxml_disable_entity_loader() was removed in PHP 8.2+
  if (function_exists('libxml_disable_entity_loader')) {
    libxml_disable_entity_loader(true);
  }
  libxml_use_internal_errors(true);

  $params = drupal_get_query_parameters();

  // --- CACHING READ ---
  // Create a unique cache ID based on the request parameters AND institute.
  $cache_key = 'oai2a:' . $institute . ':' . md5(serialize($params));
  $cache = cache_get($cache_key, 'cache');

  // If a valid cache entry exists, return it immediately.
  if ($cache && !empty($cache->data) && time() < $cache->expire) {
      echo $cache->data;
      drupal_exit();
  }

  $verb = isset($params['verb']) ? $params['verb'] : '';

  // Initialize the XML response structure
  $xml = new SimpleXMLElement('<OAI-PMH xmlns="http://www.openarchives.org/OAI/2.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/ http://www.openarchives.org/OAI/2.0/OAI-PMH.xsd"></OAI-PMH>');
  $xml->addChild('responseDate', gmdate('Y-m-d\TH:i:s\Z'));
  // Add institute info as XML comment via DOM (SimpleXML has no addComment method)
  $dom_root = dom_import_simplexml($xml);
  $comment = $dom_root->ownerDocument->createComment(' Institute: ' . $institute . ' ');
  $dom_root->appendChild($comment);

  // Always use 'oai2a' as the Drupal internal path.
  // Drupal's url() automatically prepends the base path (e.g., /eawag/) in subdirectory installs.
  $requestNode = $xml->addChild('request', url('oai2a', array('absolute' => TRUE)));
  if (!empty($verb)) $requestNode->addAttribute('verb', $verb);

  // Validation: resumptionToken cannot be combined with metadataPrefix
  if (isset($params['resumptionToken']) && isset($params['metadataPrefix'])) {
     $error = $xml->addChild('error', 'resumptionToken cannot be combined with metadataPrefix');
     $error->addAttribute('code', 'badArgument');
     // Do not cache errors
     _oai2a_output($xml, false);
     return;
  }

  try {
    switch ($verb) {
      case 'Identify':
        _oai2a_handle_identify($xml);
        break;
      case 'ListMetadataFormats':
        _oai2a_handle_list_formats($xml, $params);
        break;
      case 'GetRecord':
        _oai2a_handle_get_record($xml, $params);
        break;
      case 'ListRecords':
        _oai2a_handle_list_records($xml, $params);
        break;
      case 'ListIdentifiers':
        _oai2a_handle_list_identifiers($xml, $params);
        break;
      case 'ListSets':
        _oai2a_handle_list_sets($xml, $params);
        break;
      default:
        $err = $xml->addChild('error', 'Invalid Verb');
        $err->addAttribute('code', 'badVerb');
    }
  } catch (Exception $e) {
    // Security: Log detailed error to watchdog, show safe error to user
    watchdog('oai2a', 'Exception: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    $err = $xml->addChild('error', htmlspecialchars('An internal error occurred: ' . $e->getMessage()));
    $err->addAttribute('code', 'noRecordsMatch');
  }

  // Only cache the response if NO error occurred
  $should_cache = true;
  if ($xml->xpath('//error')) {
      $should_cache = false;
  }

  _oai2a_output($xml, $should_cache ? $cache_key : false);
}

/**
 * Helper: Formats (Pretty Print), Caches, and Outputs the XML.
 */
function _oai2a_output($xml, $cache_key = false) {
    $dom = dom_import_simplexml($xml)->ownerDocument;
    $dom->preserveWhiteSpace = false;
    $dom->formatOutput = true;
    $output = $dom->saveXML();

    // Cache for 1 hour (3600 seconds) if key is provided
    if ($cache_key) {
        cache_set($cache_key, $output, 'cache', time() + 3600);
    }

    // Ensure no previous PHP output (like Notices from third-party modules in hook_init)
    // corrupts the strict XML response. Clear the entire output buffer stack.
    while (ob_get_level()) {
        ob_end_clean();
    }

    echo $output;
    drupal_exit();
}

/**
 * OAI Verb: Identify
 */
function _oai2a_handle_identify($xml) {
  $institute = drupal_static('_oai2a_current_institute', 'all');

  $identify = $xml->addChild('Identify');
  // Branding: Append institute name to repository name
  $repo_name = variable_get('site_name', 'Islandora Repository') . ($institute !== 'all' ? ' (' . ucfirst($institute) . ')' : '');
  $identify->addChild('repositoryName', htmlspecialchars($repo_name));
  $identify->addChild('baseURL', url('oai2a', array('absolute' => TRUE)));
  $identify->addChild('protocolVersion', '2.0');
  $identify->addChild('adminEmail', variable_get('site_mail', 'admin@example.com'));
  $identify->addChild('earliestDatestamp', '2000-01-01T00:00:00Z');
  $identify->addChild('deletedRecord', 'no');
  $identify->addChild('granularity', 'YYYY-MM-DDThh:mm:ssZ');

  // Add description block with oai-identifier
  $desc = $identify->addChild('description');
  // Note: SimpleXML handles the namespace declaration automatically when the 3rd argument is provided.
  // We do NOT need to addAttribute('xmlns', ...) manually, as that causes "Attribute xmlns redefined" error.
  $oaiId = $desc->addChild('oai-identifier', null, 'http://www.openarchives.org/OAI/2.0/oai-identifier');
  $oaiId->addAttribute('xsi:schemaLocation', 'http://www.openarchives.org/OAI/2.0/oai-identifier http://www.openarchives.org/OAI/2.0/oai-identifier.xsd', 'http://www.w3.org/2001/XMLSchema-instance');

  $oaiId->addChild('scheme', 'oai', 'http://www.openarchives.org/OAI/2.0/oai-identifier');
  $host = parse_url(url('oai2a', array('absolute' => TRUE)), PHP_URL_HOST);
  $oaiId->addChild('repositoryIdentifier', $host, 'http://www.openarchives.org/OAI/2.0/oai-identifier');
  $oaiId->addChild('delimiter', ':', 'http://www.openarchives.org/OAI/2.0/oai-identifier');
  $oaiId->addChild('sampleIdentifier', 'oai:' . $host . ':' . ($institute == 'all' ? 'all' : $institute) . ':1', 'http://www.openarchives.org/OAI/2.0/oai-identifier');
}
/**
 * OAI Verb: ListMetadataFormats
 */
function _oai2a_handle_list_formats($xml, $params) {
  // If identifier is provided, check if it exists
  if (isset($params['identifier'])) {
      // Impersonate Admin to ensure we can load the object via Fedora API
      global $user;
      $original_user = $user;
      $user = user_load(1);

      try {
          $object = islandora_object_load($params['identifier']);
      } catch (Exception $e) {
          $object = null;
      }

      $user = $original_user;

      if (!$object) {
          $xml->addChild('error', 'The object does not exist or access is denied.')->addAttribute('code', 'idDoesNotExist');
          return;
      }
  }

  $formats = $xml->addChild('ListMetadataFormats');

  // Dublin Core
  $dc = $formats->addChild('metadataFormat');
  $dc->addChild('metadataPrefix', 'oai_dc');
  $dc->addChild('schema', 'http://www.openarchives.org/OAI/2.0/oai_dc.xsd');
  $dc->addChild('metadataNamespace', 'http://www.openarchives.org/OAI/2.0/oai_dc/');

  // OpenAIRE
  $openaire = $formats->addChild('metadataFormat');
  $openaire->addChild('metadataPrefix', 'oai_openaire');
  $openaire->addChild('schema', 'https://www.openaire.eu/schema/repo-lit/4.0/openaire.xsd');
  $openaire->addChild('metadataNamespace', 'http://namespace.openaire.eu/schema/oaire/');

  // Qualified Dublin Core
  $qdc = $formats->addChild('metadataFormat');
  $qdc->addChild('metadataPrefix', 'oai_qdc');
  $qdc->addChild('schema', 'http://dublincore.org/schemas/xmls/qdc/2006/01/06/dcterms.xsd');
  $qdc->addChild('metadataNamespace', 'http://purl.org/dc/terms/');

  // MODS
  $mods = $formats->addChild('metadataFormat');
  $mods->addChild('metadataPrefix', 'mods');
  $mods->addChild('schema', 'http://www.loc.gov/standards/mods/v3/mods-3-7.xsd');
  $mods->addChild('metadataNamespace', 'http://www.loc.gov/mods/v3');
}

/**
 * OAI Verb: GetRecord
 * Retrieves a single record via Fedora (Fallback mode without Solr metadata).
 */
function _oai2a_handle_get_record($xml, $params) {
  if (empty($params['identifier']) || empty($params['metadataPrefix'])) {
    $xml->addChild('error', 'Missing arguments')->addAttribute('code', 'badArgument');
    return;
  }

  // Impersonate Admin to ensure we can load the object via Fedora API
  global $user;
  $original_user = $user;
  $user = user_load(1);

  // Convert OAI identifier to Fedora PID
  // oai:dora:eawag_19000 → eawag:19000
  $identifier = $params['identifier'];
  if (strpos($identifier, 'oai:') === 0) {
      $parts = explode(':', $identifier, 3);
      if (count($parts) === 3) {
          $local = $parts[2]; // eawag_19000
          // Replace last underscore with colon to get Fedora PID
          $pos = strrpos($local, '_');
          if ($pos !== false) {
              $identifier = substr($local, 0, $pos) . ':' . substr($local, $pos + 1);
          } else {
              $identifier = $local;
          }
      }
  }

  try {
      $object = islandora_object_load($identifier);
      // --- CROSS-INSTITUTE SECURITY ---
      // This prevents a user on the /eawag/oai2a endpoint from retrieving records from /psi/.
      $institute = drupal_static('_oai2a_current_institute', 'all');
      if ($institute !== 'all' && $object && strpos($object->id, $institute . ':') !== 0) {
          $object = null; // Deny access
      }
  } catch (Exception $e) {
      $object = null;
  }

  $user = $original_user;

  if (!$object) {
    $xml->addChild('error', 'The object does not exist or access is denied.')->addAttribute('code', 'idDoesNotExist');
    return;
  }

  $record = $xml->addChild('GetRecord')->addChild('record');

  // Extract sets from RELS-EXT (collection memberships)
  $sets = array();
  if (isset($object['RELS-EXT'])) {
      $rels_content = $object['RELS-EXT']->content;
      if ($rels_content) {
          $rels_xml = new SimpleXMLElement($rels_content);
          $rels_xml->registerXPathNamespace('fedora', 'info:fedora/fedora-system:def/relations-external#');
          foreach ($rels_xml->xpath('//fedora:isMemberOfCollection') as $member) {
              $res = (string)$member->attributes('http://www.w3.org/1999/02/22-rdf-syntax-ns#')->resource;
              if ($res) {
                  $parts = explode('/', $res);
                  $set_spec = end($parts);
                  $sets[] = str_replace(':', '_', $set_spec);
              }
          }
      }
  }

  _oai2a_build_header($record, $object->id, $object->lastModifiedDate, $sets);

  // Generate Metadata: Pass empty array for solr_doc to trigger MODS fallback parsing
  // Check if the requested metadataPrefix is supported
  $supported_prefixes = array('oai_dc', 'oai_openaire', 'mods', 'oai_qdc');
  if (!in_array($params['metadataPrefix'], $supported_prefixes)) {
      $xml->addChild('error', 'The metadataPrefix is not supported.')->addAttribute('code', 'cannotDisseminateFormat');
      return;
  }

  _oai2a_generate_metadata($record->addChild('metadata'), $object, null, $params['metadataPrefix'], array());
}

/**
 * OAI Verb: ListIdentifiers
 * Uses Direct HTTP Solr Request for performance and robustness.
 */
function _oai2a_handle_list_identifiers($xml, $params) {
  $batch_size = 50; // Records per page
  $offset = 0;
  $prefix = '';
  $from = null;
  $until = null;
  $set = null;

  // --- TOKEN HANDLING ---
  if (isset($params['resumptionToken']) && !empty($params['resumptionToken'])) {
      $token_raw = base64_decode($params['resumptionToken']);
      $parts = explode('|', $token_raw);

      // Expected format: prefix|offset|from|until|set|signature
      if (count($parts) != 6) {
          $xml->addChild('error', 'Invalid resumptionToken format.')->addAttribute('code', 'badResumptionToken');
          return;
      }

      $prefix_candidate = $parts[0];
      $offset_candidate = $parts[1];
      $from_candidate = $parts[2];
      $until_candidate = $parts[3];
      $set_candidate = $parts[4];
      $signature_provided = $parts[5];

      // Verify signature to prevent tampering
      $institute = drupal_static('_oai2a_current_institute', 'all');
      $data_to_sign = $prefix_candidate . '|' . $offset_candidate . '|' . $from_candidate . '|' . $until_candidate . '|' . $set_candidate;
      $expected_signature = drupal_hmac_base64($institute . '|' . $data_to_sign, drupal_get_private_key());

      if ($signature_provided !== $expected_signature) {
           $xml->addChild('error', 'The resumptionToken has been tampered with.')->addAttribute('code', 'badResumptionToken');
           return;
      }

      $prefix = $prefix_candidate;
      $offset = (int)$offset_candidate;
      $from = ($from_candidate !== '') ? $from_candidate : null;
      $until = ($until_candidate !== '') ? $until_candidate : null;
      $set = ($set_candidate !== '') ? $set_candidate : null;
  }
  elseif (isset($params['metadataPrefix'])) {
      $prefix = $params['metadataPrefix'];
      $offset = 0;
      $from = isset($params['from']) ? $params['from'] : null;
      $until = isset($params['until']) ? $params['until'] : null;
      $set = isset($params['set']) ? $params['set'] : null;
  } else {
      $xml->addChild('error', 'Missing metadataPrefix argument')->addAttribute('code', 'badArgument');
      return;
  }

  // --- VALIDATION ---
  if ($from && !strtotime($from)) {
      $xml->addChild('error', 'Invalid from date format.')->addAttribute('code', 'badArgument');
      return;
  }
  if ($until && !strtotime($until)) {
      $xml->addChild('error', 'Invalid until date format.')->addAttribute('code', 'badArgument');
      return;
  }
  if ($from && $until && strtotime($from) > strtotime($until)) {
      $xml->addChild('error', 'from date cannot be later than until date.')->addAttribute('code', 'badArgument');
      return;
  }

  // --- SOLR REQUEST ---
  // Switch to Admin to ensure system connectivity
  global $user;
  $original_user = $user;
  $user = user_load(1);

  $solr_docs = array();
  $total_count = 0;
  $request_url = '';

  try {
      // Build the Direct HTTP Request
      // We filter by Content Model (Citation/Publication) and ensure it is public
      $query_string = 'RELS_EXT_hasModel_uri_ms:"info:fedora/ir:citationCModel" AND RELS_EXT_isViewableByRole_literal_mt:"anonymous user"';

      // --- SOLR NAMESPACE FILTERING ---
      // Dynamically restrict results to the current institute using the PID field.
      // e.g., Filter by PID:eawag:* for the Eawag endpoint.
      $institute = drupal_static('_oai2a_current_institute', 'all');
      if ($institute !== 'all') {
          $query_string .= ' AND PID:' . $institute . '\\:*';
      }

      // Date Filtering
      if ($from || $until) {
          // Solr requires full ISO 8601 format (YYYY-MM-DDThh:mm:ssZ)
          // If only YYYY-MM-DD is provided, we need to append time.
          $f = $from ? $from : '*';
          $u = $until ? $until : '*';

          // Helper to ensure time is appended if missing
          if ($f != '*' && strpos($f, 'T') === false) $f .= 'T00:00:00Z';
          if ($u != '*' && strpos($u, 'T') === false) $u .= 'T23:59:59Z';

          $query_string .= ' AND fgs_lastModifiedDate_dt:[' . $f . ' TO ' . $u . ']';
      }

      // Set Filtering
      if ($set) {
          $query_string .= ' AND RELS_EXT_isMemberOfCollection_uri_ms:"info:fedora/' . str_replace('_', ':', $set) . '"';
      }

      // Construct field list (fl) from map to optimize performance
      // Added RELS_EXT_isMemberOfCollection_uri_ms to fetch sets
      $fl_fields = array('PID', 'fgs_lastModifiedDate_dt', 'RELS_EXT_isMemberOfCollection_uri_ms');
      $fl_string = implode(',', array_unique($fl_fields));

      $query_params = array(
          'q' => $query_string,
          'start' => $offset,
          'rows' => $batch_size,
          'sort' => 'PID asc', // Sort by PID for stable paging
          'fl' => $fl_string,
          'wt' => 'json'
      );

      // Construct full URL
      $base = oai2a_SOLR_URL . '/' . oai2a_SOLR_CORE . '/select';
      $request_url = url($base, array('query' => $query_params, 'absolute' => TRUE));

      // Execute Request
      $response = drupal_http_request($request_url);

      if ($response->code == 200) {
          $data = json_decode($response->data, true);
          if (isset($data['response']['numFound'])) {
              $total_count = (int)$data['response']['numFound'];
              $solr_docs = $data['response']['docs'];
          }
      } else {
          watchdog('oai2a', 'Solr HTTP Error @code: @msg', array('@code' => $response->code, '@msg' => $response->error), WATCHDOG_ERROR);
          throw new Exception("Solr HTTP " . $response->code . ": " . $response->error);
      }

  } catch (Exception $e) {
      $xml->addChild('error', htmlspecialchars('Solr Request failed: ' . $e->getMessage() . ' [URL: ' . $request_url . ']'))->addAttribute('code', 'noRecordsMatch');
      $user = $original_user;
      return;
  }
  // Handle No Results
  if (empty($solr_docs)) {
    $user = $original_user;
    if ($offset == 0) {
        $xml->addChild('error', 'No records found in Solr.')->addAttribute('code', 'noRecordsMatch');
        return;
    } else {
        // End of list
        $listNode = $xml->addChild('ListIdentifiers');
        $tokenNode = $listNode->addChild('resumptionToken');
        if ($total_count > 0) $tokenNode->addAttribute('completeListSize', $total_count);
        $tokenNode->addAttribute('cursor', $offset);
        return;
    }
  }

  $listNode = $xml->addChild('ListIdentifiers');

  // Process Solr Results
  foreach ($solr_docs as $doc) {
    $pid = $doc['PID'];
    try {
        // Determine Last Modified Date (Prefer Solr)
        $last_mod = isset($doc['fgs_lastModifiedDate_dt']) ? new DateTime($doc['fgs_lastModifiedDate_dt']) : new DateTime();

        // Extract sets from Solr doc
        $sets = array();
        if (isset($doc['RELS_EXT_isMemberOfCollection_uri_ms'])) {
            $collections = $doc['RELS_EXT_isMemberOfCollection_uri_ms'];
            if (!is_array($collections)) {
                $collections = array($collections);
            }
            foreach ($collections as $col_uri) {
                // Extract the PID part from info:fedora/PID
                $parts = explode('/', $col_uri);
                $set_spec = end($parts);
                // Clean up setSpec (replace colons with underscores if needed, though OAI allows colons)
                $sets[] = str_replace(':', '_', $set_spec);
            }
        }

        _oai2a_build_header($listNode, $pid, $last_mod, $sets);
    } catch (Exception $e) {
        watchdog('oai2a', 'Error processing @pid: @msg', array('@pid' => $pid, '@msg' => $e->getMessage()), WATCHDOG_WARNING);
    }
  }

  $user = $original_user; // Reset User

  // --- TOKEN GENERATION ---
  $next_offset = $offset + $batch_size;
  $tokenNode = $listNode->addChild('resumptionToken');
  $tokenNode->addAttribute('completeListSize', $total_count);
  $tokenNode->addAttribute('cursor', $offset);

  if ($next_offset < $total_count) {
      // --- SECURE TOKEN GENERATION ---
      // Create new signed token. We include the $institute in the HMAC signature
      // to ensure that a token generated for Eawag cannot be illegally used on the Psi endpoint.
      $institute = drupal_static('_oai2a_current_institute', 'all');
      $data_to_sign = $prefix . '|' . $next_offset . '|' . ($from ? $from : '') . '|' . ($until ? $until : '') . '|' . ($set ? $set : '');
      $signature = drupal_hmac_base64($institute . '|' . $data_to_sign, drupal_get_private_key());
      $tokenNode[0] = base64_encode($data_to_sign . '|' . $signature);
  } else {
      // Empty token = End of list
      $tokenNode[0] = '';
  }
}

/**
 * OAI Verb: ListRecords
 * Uses Direct HTTP Solr Request for performance and robustness.
 */
function _oai2a_handle_list_records($xml, $params) {
  $batch_size = 50; // Records per page
  $offset = 0;
  $prefix = '';
  $from = null;
  $until = null;
  $set = null;

  // --- CONFIGURATION: SOLR FIELD MAPPING ---
  // Field names verified against production Solr (lib-dora-prod1.emp-eaw.ch:8080)
  // Note: GSearch/Islandora uses lowercase mods_ prefix and _ms (multivalued string) suffix!
  $solr_map = array(
      'title'       => 'fgs_label_s',
      'creator'     => 'dc.creator',
      'subject'     => 'mods_subject_topic_ms',
      'description' => 'mods_abstract_ms',
      'publisher'   => 'mods_originInfo_publisher_ms',
      'contributor' => 'dc.contributor',
      'date'        => 'mods_originInfo_dateIssued_ms',
      'type'        => 'mods_genre_ms',
      'format'      => 'dc.format',
      'identifier'  => 'dc.identifier',
      'source'      => 'mods_relatedItem_host_titleInfo_title_ms',
      'language'    => 'mods_language_languageTerm_code_ms',
      'relation'    => 'dc.relation',
      'coverage'    => 'dc.coverage',
      'rights'      => 'dc.rights',
      // Additional fields for Qualified Dublin Core (dcterms)
      'doi'            => 'mods_identifier_doi_ms',
      'issn'           => 'mods_relatedItem_host_identifier_issn_ms',
      'scopus'         => 'mods_identifier_scopus_ms',
      'isbn'           => 'mods_identifier_isbn_ms',
      'volume'         => 'mods_relatedItem_host_part_detail_volume_number_ms',
      'start_page'     => 'mods_relatedItem_host_part_extent_start_ms',
      'end_page'       => 'mods_relatedItem_host_part_extent_end_ms',
      'journal_abbrev' => 'mods_relatedItem_host_titleInfo_abbreviated_title_ms',
      'pub_status'     => 'mods_note_publicationStatus_ms',
  );

  // --- TOKEN HANDLING ---
  if (isset($params['resumptionToken']) && !empty($params['resumptionToken'])) {
      $token_raw = base64_decode($params['resumptionToken']);
      $parts = explode('|', $token_raw);

      // Expected format: prefix|offset|from|until|set|signature
      if (count($parts) != 6) {
          $xml->addChild('error', 'Invalid resumptionToken format.')->addAttribute('code', 'badResumptionToken');
          return;
      }

      $prefix_candidate = $parts[0];
      $offset_candidate = $parts[1];
      $from_candidate = $parts[2];
      $until_candidate = $parts[3];
      $set_candidate = $parts[4];
      $signature_provided = $parts[5];

      // Verify signature to prevent tampering
      $institute = drupal_static('_oai2a_current_institute', 'all');
      $data_to_sign = $prefix_candidate . '|' . $offset_candidate . '|' . $from_candidate . '|' . $until_candidate . '|' . $set_candidate;
      $expected_signature = drupal_hmac_base64($institute . '|' . $data_to_sign, drupal_get_private_key());

      if ($signature_provided !== $expected_signature) {
           $xml->addChild('error', 'The resumptionToken has been tampered with.')->addAttribute('code', 'badResumptionToken');
           return;
      }

      $prefix = $prefix_candidate;
      $offset = (int)$offset_candidate;
      $from = ($from_candidate !== '') ? $from_candidate : null;
      $until = ($until_candidate !== '') ? $until_candidate : null;
      $set = ($set_candidate !== '') ? $set_candidate : null;
  }
  elseif (isset($params['metadataPrefix'])) {
      $prefix = $params['metadataPrefix'];
      $offset = 0;
      $from = isset($params['from']) ? $params['from'] : null;
      $until = isset($params['until']) ? $params['until'] : null;
      $set = isset($params['set']) ? $params['set'] : null;
  } else {
      $xml->addChild('error', 'Missing metadataPrefix argument')->addAttribute('code', 'badArgument');
      return;
  }

  // --- SOLR REQUEST ---
  // Switch to Admin to ensure system connectivity
  global $user;
  $original_user = $user;
  $user = user_load(1);

  $solr_docs = array();
  $total_count = 0;
  $request_url = '';

  try {
      // Build the Direct HTTP Request
      // We filter by Content Model (Citation/Publication) and ensure it is public
      $query_string = 'RELS_EXT_hasModel_uri_ms:"info:fedora/ir:citationCModel" AND RELS_EXT_isViewableByRole_literal_mt:"anonymous user"';

      // --- SOLR NAMESPACE FILTERING ---
      // Dynamically restrict results to the current institute using the PID field.
      $institute = drupal_static('_oai2a_current_institute', 'all');
      if ($institute !== 'all') {
          $query_string .= ' AND PID:' . $institute . '\\:*';
      }
      if ($from || $until) {
          // Solr requires full ISO 8601 format (YYYY-MM-DDThh:mm:ssZ)
          // If only YYYY-MM-DD is provided, we need to append time.
          $f = $from ? $from : '*';
          $u = $until ? $until : '*';

          // Helper to ensure time is appended if missing
          if ($f != '*' && strpos($f, 'T') === false) $f .= 'T00:00:00Z';
          if ($u != '*' && strpos($u, 'T') === false) $u .= 'T23:59:59Z';

          $query_string .= ' AND fgs_lastModifiedDate_dt:[' . $f . ' TO ' . $u . ']';
      }

      // Set Filtering
      if ($set) {
          $query_string .= ' AND RELS_EXT_isMemberOfCollection_uri_ms:"info:fedora/' . str_replace('_', ':', $set) . '"';
      }

      // Construct field list (fl) from map to optimize performance
      // Added RELS_EXT_isMemberOfCollection_uri_ms to fetch sets
      $fl_fields = array('PID', 'fgs_lastModifiedDate_dt', 'RELS_EXT_isMemberOfCollection_uri_ms', 'mods_identifier_doi_mt', 'lib4ri_publisher_mt');
      foreach ($solr_map as $solr_field) {
          if (!empty($solr_field)) $fl_fields[] = $solr_field;
      }
      $fl_string = implode(',', array_unique($fl_fields));

      $query_params = array(
          'q' => $query_string,
          'start' => $offset,
          'rows' => $batch_size,
          'sort' => 'PID asc', // Sort by PID for stable paging
          'fl' => $fl_string,
          'wt' => 'json'
      );

      // Construct full URL
      $base = oai2a_SOLR_URL . '/' . oai2a_SOLR_CORE . '/select';
      $request_url = url($base, array('query' => $query_params, 'absolute' => TRUE));

      // Execute Request
      $response = drupal_http_request($request_url);

      if ($response->code == 200) {
          $data = json_decode($response->data, true);
          if (isset($data['response']['numFound'])) {
              $total_count = (int)$data['response']['numFound'];
              $solr_docs = $data['response']['docs'];
          }
      } else {
          watchdog('oai2a', 'Solr HTTP Error @code: @msg', array('@code' => $response->code, '@msg' => $response->error), WATCHDOG_ERROR);
          throw new Exception("Solr HTTP " . $response->code . ": " . $response->error);
      }

  } catch (Exception $e) {
      $xml->addChild('error', htmlspecialchars('Solr Request failed: ' . $e->getMessage() . ' [URL: ' . $request_url . ']'))->addAttribute('code', 'noRecordsMatch');
      $user = $original_user;
      return;
  }
  // Handle No Results
  if (empty($solr_docs)) {
    $user = $original_user;
    if ($offset == 0) {
        $xml->addChild('error', 'No records found in Solr.')->addAttribute('code', 'noRecordsMatch');
        return;
    } else {
        // End of list
        $listNode = $xml->addChild('ListRecords');
        $tokenNode = $listNode->addChild('resumptionToken');
        if ($total_count > 0) $tokenNode->addAttribute('completeListSize', $total_count);
        $tokenNode->addAttribute('cursor', $offset);
        return;
    }
  }

  $listNode = $xml->addChild('ListRecords');

  // Process Solr Results
  foreach ($solr_docs as $doc) {
    $pid = $doc['PID'];
    try {
        // Load the full Fedora Object to check permissions/files
        $object = islandora_object_load($pid);
        if ($object) {
          $record = $listNode->addChild('record');

          // Determine Last Modified Date (Prefer Solr, Fallback to Object)
          $last_mod = isset($doc['fgs_lastModifiedDate_dt']) ? new DateTime($doc['fgs_lastModifiedDate_dt']) : $object->lastModifiedDate;

          // Extract sets from Solr doc
          $sets = array();
          if (isset($doc['RELS_EXT_isMemberOfCollection_uri_ms'])) {
              $collections = $doc['RELS_EXT_isMemberOfCollection_uri_ms'];
              if (!is_array($collections)) {
                  $collections = array($collections);
              }
              foreach ($collections as $col_uri) {
                  $parts = explode('/', $col_uri);
                  $set_spec = end($parts);
                  $sets[] = str_replace(':', '_', $set_spec);
              }
          }

          _oai2a_build_header($record, $pid, $last_mod, $sets);

          // Generate Metadata (Hybrid approach)
          _oai2a_generate_metadata($record->addChild('metadata'), $object, $doc, $prefix, $solr_map);
        }
    } catch (Exception $e) {
        watchdog('oai2a', 'Error processing @pid: @msg', array('@pid' => $pid, '@msg' => $e->getMessage()), WATCHDOG_WARNING);
    }
  }

  $user = $original_user; // Reset User

  // --- TOKEN GENERATION ---
  $next_offset = $offset + $batch_size;
  $tokenNode = $listNode->addChild('resumptionToken');
  $tokenNode->addAttribute('completeListSize', $total_count);
  $tokenNode->addAttribute('cursor', $offset);

  if ($next_offset < $total_count) {
      // --- SECURE TOKEN GENERATION ---
      // Create new signed token. We include the $institute in the HMAC signature
      // to ensure that a token generated for Eawag cannot be illegally used on the Psi endpoint.
      $institute = drupal_static('_oai2a_current_institute', 'all');
      $data_to_sign = $prefix . '|' . $next_offset . '|' . ($from ? $from : '') . '|' . ($until ? $until : '') . '|' . ($set ? $set : '');
      $signature = drupal_hmac_base64($institute . '|' . $data_to_sign, drupal_get_private_key());
      $tokenNode[0] = base64_encode($data_to_sign . '|' . $signature);
  } else {
      // Empty token = End of list
      $tokenNode[0] = '';
  }
}

/**
 * OAI Verb: ListSets
 * Lists all collections in the repository as OAI sets.
 */
function _oai2a_handle_list_sets($xml, $params) {
    // ResumptionToken handling for ListSets is simplified here (no paging for sets in this basic implementation)
    // If you have thousands of collections, you might need paging.
    if (isset($params['resumptionToken'])) {
        $xml->addChild('error', 'resumptionToken not supported for ListSets in this implementation')->addAttribute('code', 'badResumptionToken');
        return;
    }

    $listSets = $xml->addChild('ListSets');

    // --- SOLR NAMESPACE FILTERING ---
    // Only query for collections that belong to the current institute's namespace (PID prefix).
    $institute = drupal_static('_oai2a_current_institute', 'all');
    $query_string = 'RELS_EXT_hasModel_uri_ms:"info:fedora/islandora:collectionCModel"';
    if ($institute !== 'all') {
        $query_string .= ' AND PID:' . $institute . '\\:*';
    }
    $fl_fields = array('PID', 'fgs_label_s', 'dc.description');
    $fl_string = implode(',', $fl_fields);

    $query_params = array(
        'q' => $query_string,
        'rows' => 1000, // Fetch up to 1000 collections
        'fl' => $fl_string,
        'wt' => 'json'
    );

    $base = oai2a_SOLR_URL . '/' . oai2a_SOLR_CORE . '/select';
    $request_url = url($base, array('query' => $query_params, 'absolute' => TRUE));

    try {
        $response = drupal_http_request($request_url);
        if ($response->code == 200) {
            $data = json_decode($response->data, true);
            if (isset($data['response']['docs'])) {
                foreach ($data['response']['docs'] as $doc) {
                    $set = $listSets->addChild('set');
                    // Use PID as setSpec, replacing colon with underscore for safety (though colon is allowed)
                    // Consistent with ListRecords logic
                    $setSpec = str_replace(':', '_', $doc['PID']);
                    $set->addChild('setSpec', htmlspecialchars($setSpec));

                    $setName = isset($doc['fgs_label_s']) ? $doc['fgs_label_s'] : $doc['PID'];
                    $set->addChild('setName', htmlspecialchars($setName));

                    if (isset($doc['dc.description'])) {
                        $desc = is_array($doc['dc.description']) ? $doc['dc.description'][0] : $doc['dc.description'];
                        // Optional: Add setDescription container if needed, but OAI-PMH allows description inside set?
                        // Actually, setDescription is a container for extensible metadata.
                        // For simplicity, we often skip it or put dc inside.
                        // Let's skip setDescription for now to keep it simple and valid.
                    }
                }
            }
        } else {
             throw new Exception("Solr HTTP " . $response->code);
        }
    } catch (Exception $e) {
        $xml->addChild('error', htmlspecialchars('Could not retrieve sets: ' . $e->getMessage()))->addAttribute('code', 'noSetHierarchy');
    }
}

/**
 * Helper: Builds the OAI Header block.
 */
function _oai2a_build_header($parent, $pid, $last_mod, $sets = array()) {
  $header = ($parent->getName() == 'header') ? $parent : $parent->addChild('header');
  // OAI identifier format: oai:<repositoryIdentifier>:<localIdentifier>
  // e.g., eawag:19000 → oai:dora:eawag_19000
  $oai_id = 'oai:dora:' . str_replace(':', '_', $pid);
  $header->addChild('identifier', htmlspecialchars($oai_id));
  if ($last_mod instanceof DateTime) $last_mod = $last_mod->format('Y-m-d\TH:i:s\Z');
  $header->addChild('datestamp', $last_mod);

  foreach ($sets as $setSpec) {
      $header->addChild('setSpec', htmlspecialchars($setSpec));
  }
}
/**
 * Logic: Analyzes access rights based on RELS-INT datastream.
 * Determines Open Access status, specific licenses, and versions.
 */
function _oai2a_analyze_access($object) {
  $result = array('is_open_access' => false, 'license' => '', 'version' => '', 'best_dsid' => '', 'embargo_end_date' => null, 'access_rights_uri' => 'http://purl.org/coar/access_right/c_16ec');

  if (!isset($object['RELS-INT'])) return $result;
  $content = $object['RELS-INT']->content;
  if (!$content) return $result;

  $xml = new SimpleXMLElement($content);
  $xml->registerXPathNamespace('rdf', 'http://www.w3.org/1999/02/22-rdf-syntax-ns#');
  $xml->registerXPathNamespace('islandora', 'http://islandora.ca/ontology/relsint#');

  $candidates = array();

  // Find all datastreams (descriptions)
  foreach ($xml->xpath('//rdf:Description') as $desc) {
      $about = (string)$desc->attributes('rdf', true)->about;
      $dsid = substr($about, strrpos($about, '/') + 1);

      // We only care about PDF files
      if (strpos($dsid, 'PDF') === false) continue;

      $children = $desc->children('http://islandora.ca/ontology/relsint#');
      $availability = (string)$children->{'lib4ridora-multi-embargo-availability'};
      $version_text = (string)$children->{'lib4ridora-multi-embargo-document_version'};
      $license_text = (string)$children->{'lib4ridora-multi-embargo-use_permission'};
      $embargo_date = (string)$children->{'lib4ridora-multi-embargo-embargo_date'};

      // Determine if file is currently public
      $is_public_now = false;
      if ($availability === 'public') {
          if (!empty($embargo_date)) {
              if (time() >= strtotime($embargo_date)) $is_public_now = true;
          } else {
              $is_public_now = true;
          }
      }
      $candidates[] = array('dsid' => $dsid, 'is_public_now' => $is_public_now, 'version' => $version_text, 'license' => $license_text, 'embargo_date' => $embargo_date, 'availability' => $availability);
  }

  if (empty($candidates)) return $result;

  // Selection Strategy: Published > Accepted > Any Public
  $selected = null;
  foreach ($candidates as $c) { if ($c['is_public_now'] && strpos(strtolower($c['version']), 'published') !== false) { $selected = $c; break; } }
  if (!$selected) foreach ($candidates as $c) { if ($c['is_public_now'] && strpos(strtolower($c['version']), 'accepted') !== false) { $selected = $c; break; } }
  if (!$selected) foreach ($candidates as $c) { if ($c['is_public_now']) { $selected = $c; break; } }

  // If nothing is open, check for future embargoes (for metadata purposes)
  if (!$selected) {
      foreach ($candidates as $c) {
          if ($c['availability'] === 'public' && !empty($c['embargo_date'])) {
              $result['access_rights_uri'] = 'http://purl.org/coar/access_right/c_f1cf'; // Embargoed
              $result['embargo_end_date'] = $c['embargo_date'];
              $result['version'] = $c['version'];
              return $result;
          }
      }
      return $result; // Restricted
  }

  // Found an open file
  $result['is_open_access'] = true;
  $result['license'] = $selected['license'];
  $result['version'] = $selected['version'];
  $result['best_dsid'] = $selected['dsid'];
  $result['access_rights_uri'] = 'http://purl.org/coar/access_right/c_abf2'; // Open Access
  return $result;
}

/**
 * Maps text licenses (e.g. "CC BY") to standard URIs.
 */
function _oai2a_map_license_to_uri($license_text) {
    $map = array(
        // Mapping removed as versions are unknown in DORA.
    );
    $key = trim(strtoupper($license_text));
    return isset($map[$key]) ? $map[$key] : null;
}

/**
 * Maps version strings to COAR URIs.
 */
function _oai2a_map_version($version_text) {
    $v = strtolower($version_text);
    if (strpos($v, 'published') !== false) return 'http://purl.org/coar/version/c_970fb48d4fbd8a85'; // VoR
    if (strpos($v, 'accepted') !== false) return 'http://purl.org/coar/version/c_ab4af688f83e57aa'; // AM
    if (strpos($v, 'submitted') !== false) return 'http://purl.org/coar/version/c_71e4c180996972fc'; // SM
    return null;
}

/**
 * Helper: Parses RELS-EXT for fallback access rights.
 */
function _oai2a_parse_rels_ext($object) {
  $info = array('is_open_access' => false);
  if (!isset($object['RELS-EXT'])) return $info;
  $content = $object['RELS-EXT']->content;
  if ($content) {
      $xml = new SimpleXMLElement($content);
      $xml->registerXPathNamespace('islandora', 'http://islandora.ca/ontology/relsext#');
      $xml->registerXPathNamespace('fedora', 'info:fedora/fedora-system:def/relations-external#');
      if ($xml->xpath('//islandora:fullText')) {
          $fulltext = $xml->xpath('//islandora:fullText');
          if (stripos((string)$fulltext[0], 'Open Access') !== false) $info['is_open_access'] = true;
      }
      foreach ($xml->xpath('//fedora:isMemberOfCollection') as $member) {
          $res = (string)$member->attributes('rdf', true)->resource;
          if (strpos($res, 'eawag:open_access') !== false) $info['is_open_access'] = true;
      }
  }
  return $info;
}

/**
 * Helper: Safely retrieves a value (or array of values) from a Solr doc.
 */
function _oai2a_get_solr_val($doc, $field) {
    if (empty($field) || !isset($doc[$field])) return array();
    $val = $doc[$field];
    if (is_array($val)) return $val;
    return array($val);
}

/**
 * Helper: Parses MODS name parts into a full name string.
 */
function _oai2a_get_mods_fullname($name_node) {
    $parts = $name_node->xpath('mods:namePart');
    if (!$parts) return '';
    $family = ''; $given = ''; $plain = array();
    foreach ($parts as $part) {
        $type = (string)$part['type']; $val = trim((string)$part);
        if ($type == 'family') $family = $val; elseif ($type == 'given') $given = $val; else $plain[] = $val;
    }
    if ($family) return $family . ($given ? ', ' . $given : ''); elseif (!empty($plain)) return implode(' ', $plain);
    return '';
}

/**
 * Main Metadata Generation Function.
 * Supports Hybrid mode (Solr + MODS/Fedora) and Fallback mode (MODS only).
 */
function _oai2a_generate_metadata($metadataNode, $object, $solr_doc, $prefix, $solr_map) {
  // Always load MODS as fallback or for complex structures
  $mods_content = isset($object['MODS']) ? $object['MODS']->content : null;
  if (!$mods_content) return;
  $mods_xml = new SimpleXMLElement($mods_content);
  $mods_xml->registerXPathNamespace('mods', 'http://www.loc.gov/mods/v3');

  // Analyze Rights
  $access_data = _oai2a_analyze_access($object);
  if (!$access_data['is_open_access'] && !$access_data['embargo_end_date']) {
      $ext_data = _oai2a_parse_rels_ext($object);
      if ($ext_data['is_open_access']) $access_data['is_open_access'] = true;
  }

  // PDF Download URL
  $pdf_url = null;
  if ($access_data['is_open_access'] && !empty($access_data['best_dsid'])) {
      $pdf_url = url("islandora/object/{$object->id}/datastream/{$access_data['best_dsid']}/view", array('absolute' => TRUE));
  }

  $use_solr = !empty($solr_doc);

  // --- OAI_DC FORMAT ---
  if ($prefix == 'oai_dc') {
    $dc_ns = 'http://purl.org/dc/elements/1.1/';
    $oai_dc_ns = 'http://www.openarchives.org/OAI/2.0/oai_dc/';
    $xsi_ns = 'http://www.w3.org/2001/XMLSchema-instance';

    // Use DOM to create the root element with proper namespace declarations.
    // This prevents SimpleXML from repeating namespaces on every child.
    $dom_metadata = dom_import_simplexml($metadataNode);
    $dom = $dom_metadata->ownerDocument;

    $element = $dom->createElementNS($oai_dc_ns, 'oai_dc:dc');
    $dom_metadata->appendChild($element);

    // Manually add namespace declarations using setAttributeNS
    $element->setAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns:oai_dc', $oai_dc_ns);
    $element->setAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns:dc', $dc_ns);
    $element->setAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns:xsi', $xsi_ns);
    $element->setAttributeNS($xsi_ns, 'xsi:schemaLocation', 'http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd');

    // Switch back to SimpleXML for population
    $oai_dc = simplexml_import_dom($element);

    if ($use_solr) {
        // WICHTIG: Namespace URI ($dc_ns) muss bei jedem addChild angegeben werden!
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['title']) as $v)
            $oai_dc->addChild('dc:title', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['creator']) as $v)
            $oai_dc->addChild('dc:creator', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['subject']) as $v)
            $oai_dc->addChild('dc:subject', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['description']) as $v)
            $oai_dc->addChild('dc:description', htmlspecialchars($v), $dc_ns);

        // Publisher Logic: Check lib4ri_publisher_mt first, then fallback to mapped field
        $publishers = _oai2a_get_solr_val($solr_doc, 'lib4ri_publisher_mt');
        if (empty($publishers)) {
            $publishers = _oai2a_get_solr_val($solr_doc, $solr_map['publisher']);
        }
        foreach ($publishers as $v)
            $oai_dc->addChild('dc:publisher', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['contributor']) as $v)
            $oai_dc->addChild('dc:contributor', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['date']) as $v)
            $oai_dc->addChild('dc:date', htmlspecialchars($v), $dc_ns);

        // DCMI Type from typeOfResource (e.g., "Text")
        foreach (_oai2a_get_solr_val($solr_doc, 'mods_typeOfResource_ms') as $v)
            $oai_dc->addChild('dc:type', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['type']) as $v) {
            $oai_dc->addChild('dc:type', htmlspecialchars($v), $dc_ns);
            // DRIVER 2.0: Map type to info:eu-repo URI
            $driver_type = _oai2a_map_type_to_driver($v);
            if ($driver_type)
                $oai_dc->addChild('dc:type', $driver_type, $dc_ns);
        }

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['format']) as $v)
            $oai_dc->addChild('dc:format', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['identifier']) as $v)
            $oai_dc->addChild('dc:identifier', htmlspecialchars($v), $dc_ns);

        // Add DOI specifically
        foreach (_oai2a_get_solr_val($solr_doc, 'mods_identifier_doi_mt') as $v)
            $oai_dc->addChild('dc:identifier', 'doi:' . htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['source']) as $v)
            $oai_dc->addChild('dc:source', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['language']) as $v)
            $oai_dc->addChild('dc:language', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['relation']) as $v)
            $oai_dc->addChild('dc:relation', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['coverage']) as $v)
            $oai_dc->addChild('dc:coverage', htmlspecialchars($v), $dc_ns);

        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['rights']) as $v)
            $oai_dc->addChild('dc:rights', htmlspecialchars($v), $dc_ns);

    } else {
        // Fallback: Parse MODS directly (used by GetRecord)
        // All values are filtered: empty MODS elements are skipped.

        // Only top-level titles (exclude titles inside relatedItem, which go to dc:source)
        foreach ($mods_xml->xpath('//mods:titleInfo[not(ancestor::mods:relatedItem)]/mods:title') as $title) {
            $v = trim((string)$title);
            if ($v !== '') $oai_dc->addChild('dc:title', htmlspecialchars($v), $dc_ns);
        }

        // Name handling: Check role to distinguish creator/contributor/funder
        foreach ($mods_xml->xpath('//mods:name') as $name) {
            $fn = _oai2a_get_mods_fullname($name);
            if (!$fn) continue;

            // Determine role from mods:role/mods:roleTerm
            $role = 'author'; // default
            $roles = $name->xpath('mods:role/mods:roleTerm');
            if ($roles) {
                foreach ($roles as $r) {
                    $rt = strtolower(trim((string)$r));
                    if ($rt === 'funder') { $role = 'funder'; break; }
                    // Match all non-author roles (exact or partial)
                    if (in_array($rt, array('editor', 'edt', 'contributor', 'supervisor', 'collaborator', 'thesis advisor', 'advisor', 'ths', 'degree supervisor', 'degree grantor'))
                        || strpos($rt, 'advisor') !== false
                        || strpos($rt, 'supervisor') !== false
                        || strpos($rt, 'editor') !== false) {
                        $role = 'contributor';
                    }
                }
            }

            if ($role === 'funder') continue; // Skip funders in DC
            if ($role === 'contributor') {
                $oai_dc->addChild('dc:contributor', htmlspecialchars($fn), $dc_ns);
            } else {
                $oai_dc->addChild('dc:creator', htmlspecialchars($fn), $dc_ns);
            }
        }

        $d = $mods_xml->xpath('//mods:originInfo/mods:dateIssued');
        if ($d && trim((string)$d[0]) !== '') $oai_dc->addChild('dc:date', htmlspecialchars(trim((string)$d[0])), $dc_ns);

        foreach ($mods_xml->xpath('//mods:subject/mods:topic') as $subject) {
            $v = trim((string)$subject);
            if ($v !== '') $oai_dc->addChild('dc:subject', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:abstract') as $desc) {
            $v = trim((string)$desc);
            if ($v !== '') $oai_dc->addChild('dc:description', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:originInfo/mods:publisher') as $pub) {
            $v = trim((string)$pub);
            if ($v !== '') $oai_dc->addChild('dc:publisher', htmlspecialchars($v), $dc_ns);
        }
        // DCMI Type from typeOfResource (e.g., "Text")
        foreach ($mods_xml->xpath('//mods:typeOfResource') as $tor) {
            $v = trim((string)$tor);
            if ($v !== '') $oai_dc->addChild('dc:type', htmlspecialchars(ucfirst($v)), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:genre') as $type) {
            $type_str = trim((string)$type);
            if ($type_str === '') continue;
            $oai_dc->addChild('dc:type', htmlspecialchars($type_str), $dc_ns);
            $driver_type = _oai2a_map_type_to_driver($type_str);
            if ($driver_type)
                $oai_dc->addChild('dc:type', $driver_type, $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:physicalDescription/mods:internetMediaType') as $fmt) {
            $v = trim((string)$fmt);
            if ($v !== '') $oai_dc->addChild('dc:format', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:identifier') as $id) {
            $v = trim((string)$id);
            if ($v !== '') $oai_dc->addChild('dc:identifier', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:titleInfo/mods:title') as $src) {
            $v = trim((string)$src);
            if ($v !== '') $oai_dc->addChild('dc:source', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:language/mods:languageTerm') as $lang) {
            $v = trim((string)$lang);
            if ($v !== '') $oai_dc->addChild('dc:language', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:subject/mods:geographic') as $cov) {
            $v = trim((string)$cov);
            if ($v !== '') $oai_dc->addChild('dc:coverage', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:subject/mods:temporal') as $cov) {
            $v = trim((string)$cov);
            if ($v !== '') $oai_dc->addChild('dc:coverage', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:accessCondition') as $rights) {
            $v = trim((string)$rights);
            if ($v !== '') $oai_dc->addChild('dc:rights', htmlspecialchars($v), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:relatedItem[not(@type="host")]/mods:titleInfo/mods:title') as $rel) {
            $v = trim((string)$rel);
            if ($v !== '') $oai_dc->addChild('dc:relation', htmlspecialchars($v), $dc_ns);
        }
    }

    if ($pdf_url) $oai_dc->addChild('dc:identifier', htmlspecialchars($pdf_url), $dc_ns);

    // Add Version info to dc:type (DRIVER Guidelines)
    if (!empty($access_data['version'])) {
        $v_lower = strtolower($access_data['version']);
        if (strpos($v_lower, 'published') !== false) {
            $oai_dc->addChild('dc:type', 'info:eu-repo/semantics/publishedVersion', $dc_ns);
        } elseif (strpos($v_lower, 'accepted') !== false) {
            $oai_dc->addChild('dc:type', 'info:eu-repo/semantics/acceptedVersion', $dc_ns);
        }
    }

    if ($access_data['is_open_access']) {
        // DRIVER 2.0: Mandatory URI for Open Access
        $oai_dc->addChild('dc:rights', 'info:eu-repo/semantics/openAccess', $dc_ns);
        $l = $access_data['license'] ? $access_data['license'] : 'Open Access';
        $oai_dc->addChild('dc:rights', htmlspecialchars($l), $dc_ns);
    } elseif ($access_data['embargo_end_date']) {
        $oai_dc->addChild('dc:rights', 'info:eu-repo/semantics/embargoedAccess', $dc_ns);
        $oai_dc->addChild('dc:rights', 'Embargo end date: ' . $access_data['embargo_end_date'], $dc_ns);
    } else {
        $oai_dc->addChild('dc:rights', 'info:eu-repo/semantics/restrictedAccess', $dc_ns);
        $oai_dc->addChild('dc:rights', 'Restricted Access', $dc_ns);
    }
  }

  // --- OAI_QDC FORMAT (Qualified Dublin Core / dcterms) ---
  elseif ($prefix == 'oai_qdc') {
    $dc_ns = 'http://purl.org/dc/elements/1.1/';
    $dcterms_ns = 'http://purl.org/dc/terms/';
    $xsi_ns = 'http://www.w3.org/2001/XMLSchema-instance';

    // Build root element with proper namespaces via DOM
    $dom_metadata = dom_import_simplexml($metadataNode);
    $dom = $dom_metadata->ownerDocument;

    $element = $dom->createElementNS($dcterms_ns, 'dcterms:qualifieddc');
    $dom_metadata->appendChild($element);

    $element->setAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns:dc', $dc_ns);
    $element->setAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns:dcterms', $dcterms_ns);
    $element->setAttributeNS('http://www.w3.org/2000/xmlns/', 'xmlns:xsi', $xsi_ns);
    $element->setAttributeNS($xsi_ns, 'xsi:schemaLocation', 'http://purl.org/dc/terms/ http://dublincore.org/schemas/xmls/qdc/2006/01/06/dcterms.xsd');

    $qdc = simplexml_import_dom($element);

    if ($use_solr) {
        // --- Title ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['title']) as $v)
            $qdc->addChild('dc:title', htmlspecialchars($v), $dc_ns);

        // --- Creator ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['creator']) as $v)
            $qdc->addChild('dc:creator', htmlspecialchars($v), $dc_ns);

        // --- Subject ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['subject']) as $v)
            $qdc->addChild('dc:subject', htmlspecialchars($v), $dc_ns);

        // --- Abstract (dcterms:abstract instead of dc:description) ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['description']) as $v)
            $qdc->addChild('dcterms:abstract', htmlspecialchars($v), $dcterms_ns);

        // --- Publisher ---
        $publishers = _oai2a_get_solr_val($solr_doc, 'lib4ri_publisher_mt');
        if (empty($publishers)) $publishers = _oai2a_get_solr_val($solr_doc, $solr_map['publisher']);
        foreach ($publishers as $v)
            $qdc->addChild('dc:publisher', htmlspecialchars($v), $dc_ns);

        // --- Contributor ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['contributor']) as $v)
            $qdc->addChild('dc:contributor', htmlspecialchars($v), $dc_ns);

        // --- Date Issued (dcterms:issued instead of dc:date) ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['date']) as $v)
            $qdc->addChild('dcterms:issued', htmlspecialchars($v), $dcterms_ns);

        // --- Type ---
        foreach (_oai2a_get_solr_val($solr_doc, 'mods_typeOfResource_ms') as $v)
            $qdc->addChild('dc:type', htmlspecialchars($v), $dc_ns);
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['type']) as $v) {
            $qdc->addChild('dc:type', htmlspecialchars($v), $dc_ns);
            $driver_type = _oai2a_map_type_to_driver($v);
            if ($driver_type) $qdc->addChild('dc:type', $driver_type, $dc_ns);
        }

        // --- Identifier: PID ---
        $qdc->addChild('dc:identifier', htmlspecialchars($object->id), $dc_ns);

        // --- Identifier: DOI (typed) ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['doi']) as $v)
            $qdc->addChild('dcterms:identifier', 'doi:' . htmlspecialchars($v), $dcterms_ns);

        // --- Identifier: ISSN (typed) ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['issn']) as $v)
            $qdc->addChild('dcterms:identifier', 'issn:' . htmlspecialchars($v), $dcterms_ns);

        // --- Identifier: ISBN (typed) ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['isbn']) as $v)
            $qdc->addChild('dcterms:identifier', 'isbn:' . htmlspecialchars($v), $dcterms_ns);
        $host_isbn = _oai2a_get_solr_val($solr_doc, 'mods_relatedItem_host_identifier_isbn_ms');
        foreach ($host_isbn as $v)
            $qdc->addChild('dcterms:identifier', 'isbn:' . htmlspecialchars($v), $dcterms_ns);

        // --- Identifier: Scopus EID (typed) ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['scopus']) as $v)
            $qdc->addChild('dcterms:identifier', 'scopus:' . htmlspecialchars($v), $dcterms_ns);

        // --- isPartOf: Journal/Book Title ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['source']) as $v)
            $qdc->addChild('dcterms:isPartOf', htmlspecialchars($v), $dcterms_ns);

        // --- Bibliographic Citation (constructed) ---
        $abbrev = _oai2a_get_solr_val($solr_doc, $solr_map['journal_abbrev']);
        $vol    = _oai2a_get_solr_val($solr_doc, $solr_map['volume']);
        $sp     = _oai2a_get_solr_val($solr_doc, $solr_map['start_page']);
        $ep     = _oai2a_get_solr_val($solr_doc, $solr_map['end_page']);
        $date   = _oai2a_get_solr_val($solr_doc, $solr_map['date']);
        if (!empty($abbrev) || !empty($vol) || !empty($sp)) {
            $cite = !empty($abbrev) ? $abbrev[0] : '';
            if (!empty($vol)) $cite .= ($cite ? ', ' : '') . 'Vol. ' . $vol[0];
            if (!empty($sp)) {
                $cite .= ($cite ? ', ' : '') . 'pp. ' . $sp[0];
                if (!empty($ep)) $cite .= '-' . $ep[0];
            }
            if (!empty($date)) $cite .= ' (' . $date[0] . ')';
            $qdc->addChild('dcterms:bibliographicCitation', htmlspecialchars($cite), $dcterms_ns);
        }

        // --- Language ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['language']) as $v)
            $qdc->addChild('dc:language', htmlspecialchars($v), $dc_ns);

        // --- Relation ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['relation']) as $v)
            $qdc->addChild('dc:relation', htmlspecialchars($v), $dc_ns);

        // --- Coverage ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['coverage']) as $v)
            $qdc->addChild('dc:coverage', htmlspecialchars($v), $dc_ns);

        // --- Rights ---
        foreach (_oai2a_get_solr_val($solr_doc, $solr_map['rights']) as $v)
            $qdc->addChild('dc:rights', htmlspecialchars($v), $dc_ns);

    } else {
        // --- MODS FALLBACK for QDC ---

        // Title
        foreach ($mods_xml->xpath('//mods:titleInfo[not(ancestor::mods:relatedItem)]/mods:title') as $title) {
            $v = trim((string)$title);
            if ($v !== '') $qdc->addChild('dc:title', htmlspecialchars($v), $dc_ns);
        }

        // Creator / Contributor
        foreach ($mods_xml->xpath('//mods:name') as $name) {
            $fn = _oai2a_get_mods_fullname($name);
            if (!$fn) continue;
            $role = 'author';
            $roles = $name->xpath('mods:role/mods:roleTerm');
            if ($roles) {
                foreach ($roles as $r) {
                    $rt = strtolower(trim((string)$r));
                    if ($rt === 'funder') { $role = 'funder'; break; }
                    if (in_array($rt, array('editor', 'edt', 'contributor', 'supervisor', 'collaborator', 'thesis advisor', 'advisor', 'ths', 'degree supervisor', 'degree grantor'))
                        || strpos($rt, 'advisor') !== false || strpos($rt, 'supervisor') !== false || strpos($rt, 'editor') !== false) {
                        $role = 'contributor';
                    }
                }
            }
            if ($role === 'funder') continue;
            if ($role === 'contributor') {
                $qdc->addChild('dc:contributor', htmlspecialchars($fn), $dc_ns);
            } else {
                $qdc->addChild('dc:creator', htmlspecialchars($fn), $dc_ns);
            }
        }

        // Issued Date
        $d = $mods_xml->xpath('//mods:originInfo/mods:dateIssued');
        if ($d && trim((string)$d[0]) !== '')
            $qdc->addChild('dcterms:issued', htmlspecialchars(trim((string)$d[0])), $dcterms_ns);

        // Subject
        foreach ($mods_xml->xpath('//mods:subject/mods:topic') as $subject) {
            $v = trim((string)$subject);
            if ($v !== '') $qdc->addChild('dc:subject', htmlspecialchars($v), $dc_ns);
        }

        // Abstract
        foreach ($mods_xml->xpath('//mods:abstract') as $desc) {
            $v = trim((string)$desc);
            if ($v !== '') $qdc->addChild('dcterms:abstract', htmlspecialchars($v), $dcterms_ns);
        }

        // Publisher
        foreach ($mods_xml->xpath('//mods:originInfo/mods:publisher') as $pub) {
            $v = trim((string)$pub);
            if ($v !== '') $qdc->addChild('dc:publisher', htmlspecialchars($v), $dc_ns);
        }

        // Type
        foreach ($mods_xml->xpath('//mods:typeOfResource') as $tor) {
            $v = trim((string)$tor);
            if ($v !== '') $qdc->addChild('dc:type', htmlspecialchars(ucfirst($v)), $dc_ns);
        }
        foreach ($mods_xml->xpath('//mods:genre') as $type) {
            $type_str = trim((string)$type);
            if ($type_str === '') continue;
            $qdc->addChild('dc:type', htmlspecialchars($type_str), $dc_ns);
            $driver_type = _oai2a_map_type_to_driver($type_str);
            if ($driver_type) $qdc->addChild('dc:type', $driver_type, $dc_ns);
        }

        // Identifier (PID)
        $qdc->addChild('dc:identifier', htmlspecialchars($object->id), $dc_ns);

        // DOI
        foreach ($mods_xml->xpath('//mods:identifier[@type="doi"]') as $id) {
            $v = trim((string)$id);
            if ($v !== '') $qdc->addChild('dcterms:identifier', 'doi:' . htmlspecialchars($v), $dcterms_ns);
        }

        // ISSN
        foreach ($mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:identifier[@type="issn"]') as $id) {
            $v = trim((string)$id);
            if ($v !== '') $qdc->addChild('dcterms:identifier', 'issn:' . htmlspecialchars($v), $dcterms_ns);
        }

        // ISBN
        foreach ($mods_xml->xpath('//mods:identifier[@type="isbn"] | //mods:relatedItem[@type="host"]/mods:identifier[@type="isbn"]') as $id) {
            $v = trim((string)$id);
            if ($v !== '') $qdc->addChild('dcterms:identifier', 'isbn:' . htmlspecialchars($v), $dcterms_ns);
        }

        // Scopus EID
        foreach ($mods_xml->xpath('//mods:identifier[@type="scopus"]') as $id) {
            $v = trim((string)$id);
            if ($v !== '') $qdc->addChild('dcterms:identifier', 'scopus:' . htmlspecialchars($v), $dcterms_ns);
        }

        // isPartOf (Journal title)
        foreach ($mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:titleInfo/mods:title') as $src) {
            $v = trim((string)$src);
            if ($v !== '') $qdc->addChild('dcterms:isPartOf', htmlspecialchars($v), $dcterms_ns);
        }

        // Bibliographic Citation (constructed from MODS parts)
        $abbrev_nodes = $mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:titleInfo[@type="abbreviated"]/mods:title');
        $vol_nodes    = $mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:part/mods:detail[@type="volume"]/mods:number');
        $sp_nodes     = $mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:part/mods:extent/mods:start');
        $ep_nodes     = $mods_xml->xpath('//mods:relatedItem[@type="host"]/mods:part/mods:extent/mods:end');
        $cite = '';
        if ($abbrev_nodes) $cite = trim((string)$abbrev_nodes[0]);
        if ($vol_nodes) $cite .= ($cite ? ', ' : '') . 'Vol. ' . trim((string)$vol_nodes[0]);
        if ($sp_nodes) {
            $cite .= ($cite ? ', ' : '') . 'pp. ' . trim((string)$sp_nodes[0]);
            if ($ep_nodes) $cite .= '-' . trim((string)$ep_nodes[0]);
        }
        if ($d && trim((string)$d[0]) !== '') $cite .= ' (' . trim((string)$d[0]) . ')';
        if ($cite) $qdc->addChild('dcterms:bibliographicCitation', htmlspecialchars($cite), $dcterms_ns);

        // Language
        foreach ($mods_xml->xpath('//mods:language/mods:languageTerm') as $lang) {
            $v = trim((string)$lang);
            if ($v !== '') $qdc->addChild('dc:language', htmlspecialchars($v), $dc_ns);
        }

        // Coverage
        foreach ($mods_xml->xpath('//mods:subject/mods:geographic') as $cov) {
            $v = trim((string)$cov);
            if ($v !== '') $qdc->addChild('dc:coverage', htmlspecialchars($v), $dc_ns);
        }

        // Rights
        foreach ($mods_xml->xpath('//mods:accessCondition') as $rights) {
            $v = trim((string)$rights);
            if ($v !== '') $qdc->addChild('dc:rights', htmlspecialchars($v), $dc_ns);
        }

        // Relation
        foreach ($mods_xml->xpath('//mods:relatedItem[not(@type="host")]/mods:titleInfo/mods:title') as $rel) {
            $v = trim((string)$rel);
            if ($v !== '') $qdc->addChild('dc:relation', htmlspecialchars($v), $dc_ns);
        }
    }

    // PDF URL
    if ($pdf_url) $qdc->addChild('dc:identifier', htmlspecialchars($pdf_url), $dc_ns);

    // Access Rights (dcterms:accessRights)
    if ($access_data['is_open_access']) {
        $qdc->addChild('dcterms:accessRights', 'info:eu-repo/semantics/openAccess', $dcterms_ns);
        $l = $access_data['license'] ? $access_data['license'] : 'Open Access';
        $qdc->addChild('dc:rights', htmlspecialchars($l), $dc_ns);
    } elseif ($access_data['embargo_end_date']) {
        $qdc->addChild('dcterms:accessRights', 'info:eu-repo/semantics/embargoedAccess', $dcterms_ns);
        $qdc->addChild('dc:rights', 'Embargo end date: ' . $access_data['embargo_end_date'], $dc_ns);
    } else {
        $qdc->addChild('dcterms:accessRights', 'info:eu-repo/semantics/restrictedAccess', $dcterms_ns);
        $qdc->addChild('dc:rights', 'Restricted Access', $dc_ns);
    }

    // Version (DRIVER)
    if (!empty($access_data['version'])) {
        $v_lower = strtolower($access_data['version']);
        if (strpos($v_lower, 'published') !== false) {
            $qdc->addChild('dc:type', 'info:eu-repo/semantics/publishedVersion', $dc_ns);
        } elseif (strpos($v_lower, 'accepted') !== false) {
            $qdc->addChild('dc:type', 'info:eu-repo/semantics/acceptedVersion', $dc_ns);
        }
    }
  }

  // --- OAI_OPENAIRE FORMAT ---
  elseif ($prefix == 'oai_openaire') {
    // OpenAIRE requires deep parsing, so we mostly use MODS logic here.

    $resource = $metadataNode->addChild('resource', null, 'http://namespace.openaire.eu/schema/oaire/');
    $resource->addAttribute('xmlns:rdf', 'http://www.w3.org/1999/02/22-rdf-syntax-ns#');
    $resource->addAttribute('xmlns:datacite', 'http://datacite.org/schema/kernel-4');

    // Titles
    $title_results = $mods_xml->xpath('//mods:titleInfo/mods:title');
    $title = $title_results ? (string)$title_results[0] : '';
    $titles = $resource->addChild('titles');
    $titles->addChild('title', htmlspecialchars($title));

    // Creators and Contributors
    $creators = $resource->addChild('creators');
    $contributors = $resource->addChild('contributors');
    $found_funders = array();
    $has_contributors = false;

    foreach ($mods_xml->xpath('//mods:name') as $name) {
        $roles = $name->xpath('mods:role/mods:roleTerm');
        $is_funder = false;
        $is_contributor = false;
        $role_text = '';

        if ($roles) {
            foreach ($roles as $r) {
                $rt = strtolower(trim((string)$r));
                if ($rt == 'funder') {
                    $is_funder = true;
                    $found_funders[] = $name;
                }
                if (in_array($rt, array('editor', 'contributor', 'supervisor', 'collaborator'))) {
                    $is_contributor = true;
                    $role_text = $rt;
                }
            }
        }

        if (!$is_funder) {
            $fullname = _oai2a_get_mods_fullname($name);
            if ($fullname) {
                if ($is_contributor) {
                    $c = $contributors->addChild('contributor');
                    $c->addChild('contributorName', htmlspecialchars($fullname));
                    // Map generic roles to DataCite vocabulary
                    $contributorType = 'Other';
                    if (strpos($role_text, 'editor') !== false) $contributorType = 'Editor';
                    if (strpos($role_text, 'supervisor') !== false) $contributorType = 'Supervisor';
                    $c->addAttribute('contributorType', $contributorType);
                    $has_contributors = true;
                } else {
                    $c = $creators->addChild('creator');
                    $c->addChild('creatorName', htmlspecialchars($fullname));
                }
            }
        }
    }

    // Clean up empty tags (SimpleXML artifact)
    if (!$has_contributors) unset($contributors[0]);

    // Dates
    $date = $mods_xml->xpath('//mods:originInfo/mods:dateIssued');
    if ($date) $resource->addChild('publicationYear', substr((string)$date[0], 0, 4));
    else $resource->addChild('publicationYear', gmdate('Y'));

    // Publisher
    $pub = $mods_xml->xpath('//mods:originInfo/mods:publisher');
    if ($pub) $resource->addChild('publisher', htmlspecialchars((string)$pub[0]));
    else $resource->addChild('publisher', htmlspecialchars(variable_get('site_name', 'Islandora Repository')));

    // Language
    $lang = $mods_xml->xpath('//mods:language/mods:languageTerm');
    if ($lang) $resource->addChild('language', htmlspecialchars((string)$lang[0]));
    else $resource->addChild('language', 'eng');

    // Resource Type Mapping (COAR Vocabulary)
    $genre_results = $mods_xml->xpath('//mods:genre');
    $genre = $genre_results ? strtolower((string)$genre_results[0]) : '';
    $type_uri = 'http://purl.org/coar/resource_type/c_6501'; $type_text = 'journal article';
    if (strpos($genre, 'thesis') !== false || strpos($genre, 'dissertation') !== false) { $type_uri = 'http://purl.org/coar/resource_type/c_46ec'; $type_text = 'thesis'; }
    elseif (strpos($genre, 'book') !== false && strpos($genre, 'chapter') === false) { $type_uri = 'http://purl.org/coar/resource_type/c_2f33'; $type_text = 'book'; }
    elseif (strpos($genre, 'book') !== false && strpos($genre, 'chapter') !== false) { $type_uri = 'http://purl.org/coar/resource_type/c_3248'; $type_text = 'book part'; }
    elseif (strpos($genre, 'report') !== false) { $type_uri = 'http://purl.org/coar/resource_type/c_93fc'; $type_text = 'report'; }
    elseif (strpos($genre, 'conference') !== false) { $type_uri = 'http://purl.org/coar/resource_type/c_c94f'; $type_text = 'conference output'; }

    $rt = $resource->addChild('resourceType', $type_text);
    $rt->addAttribute('resourceTypeGeneral', 'Text');
    $rt->addAttribute('uri', $type_uri);

    // Subjects
    $subjects_node = null;
    foreach ($mods_xml->xpath('//mods:subject/mods:topic') as $topic) {
        if (!$subjects_node) $subjects_node = $resource->addChild('subjects');
        $subjects_node->addChild('subject', htmlspecialchars((string)$topic));
    }

    // Descriptions / Abstracts
    $descriptions_node = null;
    foreach ($mods_xml->xpath('//mods:abstract') as $abstract) {
        if (!$descriptions_node) $descriptions_node = $resource->addChild('descriptions');
        $d = $descriptions_node->addChild('description', htmlspecialchars((string)$abstract));
        $d->addAttribute('descriptionType', 'Abstract');
    }

    // Identifiers
    $identifiers = $resource->addChild('identifiers');
    foreach ($mods_xml->xpath('//mods:identifier') as $modsid) {
        $type = (string)$modsid->attributes()->type;
        $val = trim((string)$modsid);
        if (strtolower($type) == 'doi') {
            $i = $identifiers->addChild('identifier', htmlspecialchars($val));
            $i->addAttribute('identifierType', 'DOI');
        }
    }
    // Handle
    $i = $identifiers->addChild('identifier', $object->id);
    $i->addAttribute('identifierType', 'Handle');

    // PDF Link
    if ($pdf_url) {
        $i = $identifiers->addChild('identifier', htmlspecialchars($pdf_url));
        $i->addAttribute('identifierType', 'URL');
    }

    // Versioning
    if (!empty($access_data['version'])) {
        $version_uri = _oai2a_map_version($access_data['version']);
        if ($version_uri) {
            $v = $resource->addChild('version', htmlspecialchars($access_data['version']));
            $v->addAttribute('uri', $version_uri);
        }
    }

    // Funding
    if (!empty($found_funders)) {
        $fundingRefs = $resource->addChild('fundingReferences');
        foreach ($found_funders as $funder) {
            $ref = $fundingRefs->addChild('fundingReference');
            $fullname = _oai2a_get_mods_fullname($funder);
            if ($fullname) $ref->addChild('funderName', htmlspecialchars($fullname));
        }
    }

    // Rights List
    $rightsList = $resource->addChild('rightsList');
    $r1 = $rightsList->addChild('rights', $access_data['is_open_access'] ? 'open access' : ($access_data['embargo_end_date'] ? 'embargoed access' : 'restricted access'));
    $r1->addAttribute('rightsURI', $access_data['access_rights_uri']);

    if ($access_data['is_open_access']) {
        $license_uri = _oai2a_map_license_to_uri($access_data['license']);
        if (!empty($access_data['license'])) {
            $r2 = $rightsList->addChild('rights', htmlspecialchars($access_data['license']));
            if ($license_uri) $r2->addAttribute('rightsURI', $license_uri);
        }
    }

    if ($access_data['embargo_end_date']) {
        $resource->addChild('dates')->addChild('date', $access_data['embargo_end_date'])->addAttribute('dateType', 'Available');
    }
  }

  // --- MODS FORMAT ---
  elseif ($prefix == 'mods') {
    // Inject citations
    $citation_styles = variable_get('oai2a_citation_styles', '1');
    $mods_content = _oai2a_build_citation($mods_content, $citation_styles);

    $dom_metadata = dom_import_simplexml($metadataNode);
    $dom_mods = new DOMDocument();
    // Suppress errors for malformed XML in datastream, though it should be valid
    $prev = libxml_use_internal_errors(true);
    if ($dom_mods->loadXML($mods_content)) {
      $node = $dom_metadata->ownerDocument->importNode($dom_mods->documentElement, true);
      $dom_metadata->appendChild($node);
    }
    libxml_use_internal_errors($prev);
  }
}

/**
 * Helper: Maps raw type strings to DRIVER 2.0 info:eu-repo URIs.
 */
function _oai2a_map_type_to_driver($type_string) {
    $t = strtolower($type_string);
    if (strpos($t, 'article') !== false) return 'info:eu-repo/semantics/article';
    if (strpos($t, 'thesis') !== false) {
        if (strpos($t, 'bachelor') !== false) return 'info:eu-repo/semantics/bachelorThesis';
        if (strpos($t, 'master') !== false) return 'info:eu-repo/semantics/masterThesis';
        return 'info:eu-repo/semantics/doctoralThesis';
    }
    if (strpos($t, 'book') !== false) {
        if (strpos($t, 'chapter') !== false || strpos($t, 'part') !== false) return 'info:eu-repo/semantics/bookPart';
        return 'info:eu-repo/semantics/book';
    }
    if (strpos($t, 'report') !== false) return 'info:eu-repo/semantics/report';
    if (strpos($t, 'conference') !== false) return 'info:eu-repo/semantics/conferenceObject';
    if (strpos($t, 'review') !== false) return 'info:eu-repo/semantics/review';
    if (strpos($t, 'lecture') !== false) return 'info:eu-repo/semantics/lecture';
    return null;
}

/**
 * Helper: Injects citation data into MODS via citeproc.
 */
function _oai2a_build_citation($content, $style_s) {
    if ($style_s) {
        module_load_include('module', 'citeproc', 'citeproc');

        if ($style_s == 1) {
            $style_a = CSL::GetNames();
        } else {
            $style_a = explode(':', $style_s);
        }

        $st = array();
        foreach ($style_a as $style) {
            $s = citeproc_style($style);
            if ($s && (strtolower($style) != 'bibtex')) {
                array_push($st, $s);
            }
        }

        $edited = false;
        $citations = '';
        foreach ($st as $cstyle) {
            $citation = citeproc_bibliography_from_mods($cstyle, $content);
            $citation = str_replace('<div class="csl-bib-body"><div class="csl-entry">', '', $citation);
            $citation = str_replace('</div></div>', '', $citation);
            $citation = str_replace('&', '&amp;', $citation);
            $citation = str_replace('<', '&lt;', $citation);
            $citation = str_replace('>', '&gt;', $citation);
            // $citation = str_replace('"', '&quot;', $citation);
            // $citation = str_replace("'", '&apos;', $citation);
            $citation = "<{$cstyle['name']}>$citation</{$cstyle['name']}>";
            $citations .= $citation;
            $edited = true;
        }
        if ($edited) {
            $content = str_replace("</mods>",
 "  <extension>
    <bibliographicCitation>
      $citations
    </bibliographicCitation>
  </extension>
</mods>", $content);
        }
    }

    return $content;
}